# CardioExplain AI - Environment Configuration Example

# Backend API Configuration
PROJECT_NAME="CardioExplain AI"
VERSION="1.0.0"
DATABASE_URL="sqlite:///./cardioexplain.db"

# LLM Explanation Provider ("deterministic", "openai", or "gemini")
# When LLM_PROVIDER is "deterministic" or when no API key is set,
# the platform uses its built-in rule-grounded deterministic clinical explanation engine.
LLM_PROVIDER="deterministic"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-pro"

# Processing & File Upload Limits
MAX_UPLOAD_SIZE_MB=15

# Development URLs
FRONTEND_PORT=3000
BACKEND_PORT=8000
